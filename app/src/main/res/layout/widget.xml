<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spokojniej" android:textColor="#305E50" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/widget_pause" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:gravity="center" android:background="@drawable/widget_action" android:text="Zatrzymaj się" android:textSize="17sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:contentDescription="Zatrzymaj się i rozpocznij pauzę" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_checkin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:background="@drawable/widget_secondary" android:text="Jak się czuję?" android:textColor="#305E50" android:textSize="13sp" />
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginLeft="8dp" android:gravity="center" android:background="@drawable/widget_secondary" android:text="Dziennik" android:textColor="#305E50" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
